# ==============================================================================
# BreatheWise AI — Unified Monorepo Environment Configuration Template
# ==============================================================================
#
# Quickstart Setup:
#   cp .env.example .env
#
# Architecture & Security Boundary:
#   1. Backend-Only Variables (No VITE_ prefix):
#      - Loaded strictly by FastAPI via Pydantic Settings (backend/app/core/config.py).
#      - Never exposed to the browser or bundled into the client build.
#   2. Frontend Variables (VITE_ prefix):
#      - Loaded by Vite from this root file (frontend/vite.config.ts envDir: '..').
#      - Exclusively accessible in client-side code via `import.meta.env.VITE_*`.
#
# ==============================================================================
# 1. FastAPI Backend Service Configuration
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Optional: OpenAQ v3 API Key (leave blank to run in graceful unconfigured mode)
OPENAQ_API_KEY=

# Open-Meteo Endpoints (Public access; no API key required)
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=10.0
OPENAQ_TIMEOUT_SECONDS=10.0

# Google Gemini Intelligence Engine Configuration (Phase 5)
# Optional: Set your Gemini API key to enable generative synthesis; leaves application in deterministic fallback if omitted
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12.0

# AI Insights Rate Limiting Configuration (Phase 8.4A)
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_ENABLED=true

# ==============================================================================
# 2. Vite + React Frontend Application Configuration
# ==============================================================================
# Base URL for backend API queries
VITE_API_BASE_URL=http://localhost:8000

# Firebase Web App Authentication & Firestore Persistence (Phase 7.4 & 7.5)
# Optional in development: Guest mode operates cleanly when unconfigured or using placeholder values
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
