# Root .gitignore for BreatheWise AI
# Strict rules to guarantee repository size remains well under 10 MB (PromptWars constraint)

# Node dependencies and build outputs
node_modules/
dist/
dist-ssr/
*.local
.npm/
*.tsbuildinfo
coverage/
.vitest/

# Python virtual environment and bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/

# Vite & IDE caches
.vite/
.turbo/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Secrets & Environment files
.env
.env.*
!.env.example
*.pem
serviceAccountKey.json
firebase-credentials.json

# Logs and temporary files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
tmp/
temp/
