# ==============================================================================
# BreatheWise AI — Monorepo Root Docker Build Context Exclusions
# Excludes sensitive, ephemeral, and test artifacts if Docker build context
# is executed from the repository root.
# ==============================================================================

# Environment variable files and secrets
.env
.env.*
*.env
*.pem
*.key
serviceAccountKey.json
firebase-credentials.json

# Version control and CI metadata
.git/
.github/
.gitignore

# Python virtual environments and caches
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
backend/tests/
backend/verify_live.py

# Node.js dependencies, caches, and build outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.npm/
frontend/.npm/
coverage/
frontend/coverage/
.vitest/
frontend/.vitest/
*.tsbuildinfo
frontend/*.tsbuildinfo

# Operating system and editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local logs and temporary directories
*.log
tmp/
temp/
