# BreatheWise AI Backend Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional: OpenAQ v3 API Key (leave blank to run in graceful unconfigured mode)
OPENAQ_API_KEY=

# Open-Meteo Endpoints (Public access; no API key required)
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=10.0
OPENAQ_TIMEOUT_SECONDS=10.0

# Google Gemini Intelligence Engine Configuration (Phase 5)
# Optional: Set your Gemini API key to enable generative synthesis; leaves application in deterministic fallback if omitted
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12.0
